# Variables del backend para el VPS. Copiar a backend/.env y completar lo que dice CAMBIAR.
# Después de cualquier cambio: php artisan config:cache

APP_NAME="IntelectaLab"
APP_ENV=production
APP_DEBUG=false
# CAMBIAR: generar una nueva con `php artisan key:generate --show`. No usar la de desarrollo.
# No cambiarla después: con ella se cifran las claves de las pasarelas de pago.
APP_KEY=
APP_URL=https://DOMINIO
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

TENANCY_CENTRAL_DOMAIN=DOMINIO
# Dónde vive cada academia: subdomain = {academia}.DOMINIO (necesita el registro DNS *.DOMINIO);
# path = DOMINIO/a/{academia} (sin registro comodín). Ver docs/instalacion-y-despliegue.md
TENANCY_MODE=subdomain
# Dirección de cada academia para los enlaces de los correos programados. Vacío: se deduce del modo
TENANCY_PUBLIC_URL=
# Solo si el HTTPS lo termina un proxy o balanceador delante de Nginx
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Rol sin superusuario ni BYPASSRLS: con un superusuario no se aplica el aislamiento entre academias
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erp_saas_db
DB_USERNAME=erp_app
# CAMBIAR
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database

# Archivos de las academias en el propio servidor (storage/app/private)
FILES_DISK=local
FILES_IMAGE_MAX_KB=2048
FILES_DOCUMENT_MAX_KB=51200

# Correo con Elastic Email por SMTP. CAMBIAR usuario, clave y remitente con los del panel de Elastic.
# El dominio del remitente debe estar verificado en Elastic (registros SPF y DKIM en el DNS).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.elasticemail.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=avisos@DOMINIO
MAIL_FROM_NAME="IntelectaLab"
# Los avisos salen en segundo plano: necesita el proceso de cola (deploy/supervisor/erp-queue.conf)
MAIL_QUEUE=true

# Pasarelas de pago: en Linux PHP ya trae los certificados raíz; se deja vacío
PAYMENTS_CA_BUNDLE=
PAYMENTS_TIMEOUT=15

# Cobro a las academias
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_MAX_STUDENTS=10
BILLING_GRACE_DAYS=7
BILLING_ORDER_EXPIRATION_DAYS=7

# Acceso
AUTH_SESSION_LIFETIME=30
AUTH_PASSWORD_RESET_MINUTES=60
AUTH_LOGIN_LOCK_ATTEMPTS=10
AUTH_LOGIN_LOCK_MINUTES=15
API_RATE_LIMIT=300
